---
const links = [
  { href: '#historia', label: 'História' },
  { href: '#portfolio', label: 'Portfólio' },
  { href: '#numeros', label: 'Números' },
  { href: '#catalogos', label: 'Catálogos' },
];
const linkClass = 'font-sans text-[13px] font-medium leading-[1.2] uppercase tracking-[0.18em] text-mist no-underline transition-colors hover:text-bone';
---
<header class="pointer-events-none fixed inset-x-0 top-0 z-50">
  <nav class="pointer-events-auto flex items-center justify-between gap-4 px-gutter py-[clamp(14px,1.5vw,24px)]">
    <a href="#top" class="flex items-center gap-3 no-underline" aria-label="Voltar ao topo">
      <span class="flex items-center rounded-[5px] bg-white px-[9px] py-[5px]">
        <img src="/assets/logo-pbmed.webp" alt="Grupo PBMED Distribuidora" class="h-[15px] w-auto object-contain" />
      </span>
    </a>
    <div class="flex flex-wrap items-center justify-end gap-[clamp(14px,2.4vw,40px)]">
      {links.map((l) => <a href={l.href} class={linkClass}>{l.label}</a>)}
      <a
        href="#contato"
        class="rounded-full bg-coral px-4 py-2.5 font-sans text-[13px] font-medium leading-[1.2] uppercase tracking-[0.18em] text-ink no-underline transition-colors hover:bg-coral-light"
      >Contato</a>
    </div>
  </nav>
</header>
