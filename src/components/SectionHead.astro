---
/** Cabeçalho padrão de seção: bolinha + eyebrow + título display. */
interface Props { eyebrow: string; title: string; maxCh?: number; class?: string }
const { eyebrow, title, maxCh = 16, class: cls } = Astro.props;
---
<div data-anim class:list={['min-w-0', cls]}>
  <div class="flex items-center gap-3">
    <span class="size-2 rounded-full bg-coral"></span>
    <span class="eyebrow">{eyebrow}</span>
  </div>
  <h2 class="display-h2 mt-6" style={`max-width:${maxCh}ch`}>{title}</h2>
</div>
